    "lucide-react": "^1.33.0",
    "next": "15.5.23",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hot-toast": "^2.6.0",
    "stripe": "22.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.20",
    "eslint": "^9",
    "eslint-config-next": "15.5.23",
    "postcss": "^8.5.26",
    "postcss-color-functional-notation": "^8.0.8",
    "react-server-dom-webpack": "19.2.8",
